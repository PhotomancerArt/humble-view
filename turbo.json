{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:storybook": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#format:check": {},
    "//#check:deps": {
      "inputs": [
        "scripts/check-deps.mjs",
        "packages/*/package.json",
        "apps/*/package.json",
        "packages/*/src/**",
        "apps/*/src/**",
        "apps/*/.storybook/**",
        "apps/*/*.config.ts"
      ]
    }
  }
}
